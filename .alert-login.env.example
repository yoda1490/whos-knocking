# SSH Alert Configuration File
# Copy this file to .alert-login.env and adjust values.

# --- Alert Channels ---
# Comma-separated list of alert types: mail, slack, telegram
ALERT_TYPES=mail,slack,telegram

# --- Email Configuration ---
# Required if 'mail' present in ALERT_TYPES
RECIPIENT=admin@example.com
FROM_ADDR=ssh-alerts@example.com

# --- Slack Configuration ---
# Required if 'slack' present in ALERT_TYPES
# Get webhook URL from: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# --- Telegram Configuration ---
# Required if 'telegram' present in ALERT_TYPES
# Bot token from BotFather: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
# Chat ID where alerts will be sent (can use @username or numeric ID)
TELEGRAM_CHAT_ID=-1001234567890

# --- Geolocation Settings ---
# Enable/disable IP geolocation lookup (true/false or 1/0)
# Uses ipinfo.io API when enabled
ENABLE_IP_GEO=true

# --- Alert Exclusions ---
# Pipe-separated list of "IP:USER" patterns to exclude from alerts
# Supports wildcards:
#   * = matches any value (all IPs or all users)
#   192.168.1.* = matches IP subnet
#   admin* = matches user prefix
#
# Examples:
#   192.168.1.100:jenkins      - Skip alerts for Jenkins user from specific IP
#   192.168.1.*:jenkins        - Skip alerts for Jenkins user from entire subnet (192.168.1.0/24)
#   127.0.0.1:*                - Skip all users from localhost
#   *:root                      - Skip all root logins from any IP
#   192.168.100.5:admin*       - Skip users matching "admin*" prefix from specific IP
#   10.0.0.*:monitoring        - Skip monitoring user from 10.0.0.0/24 subnet
#   *:*                         - Skip all alerts (not recommended!)
#
# Separate multiple rules with pipe (|) character. Whitespace around rules is trimmed.
#
# Leave empty or comment out to disable exclusions.
ALERT_EXCLUSIONS=127.0.0.1:*|192.168.1.100:jenkins|192.168.0.*:automation|*:backup
